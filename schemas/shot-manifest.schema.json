{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/editorial-documentary-manifest-v5.schema.json",
  "title": "Editorial Documentary Illustration Manifest v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "article", "visual_bible", "shots"],
  "properties": {
    "version": {"type": "integer", "const": 5},
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title", "slug", "language", "annotation_language", "summary",
        "reading_minutes", "section_count", "image_count_mode", "include_hero",
        "high_value_anchor_count", "target_count", "count_reason"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "language": {"type": "string", "minLength": 2},
        "annotation_language": {"type": "string", "minLength": 2},
        "summary": {"type": "string", "minLength": 20},
        "reading_minutes": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
        "section_count": {"type": "integer", "minimum": 1, "maximum": 100},
        "image_count_mode": {"type": "string", "enum": ["auto", "fixed"]},
        "include_hero": {"type": "boolean"},
        "high_value_anchor_count": {"type": "integer", "minimum": 1, "maximum": 30},
        "target_count": {"type": "integer", "minimum": 1, "maximum": 8},
        "count_reason": {"type": "string", "minLength": 12, "maxLength": 320}
      }
    },
    "visual_bible": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background", "palette", "camera", "lighting", "cutout_style",
        "typography", "continuity_rules"
      ],
      "properties": {
        "background": {"type": "string", "minLength": 20},
        "palette": {
          "type": "array", "minItems": 4, "maxItems": 7,
          "items": {"type": "string", "minLength": 3}
        },
        "camera": {
          "type": "string",
          "enum": ["top-down-map-15deg", "flat-orthographic", "soft-isometric"]
        },
        "lighting": {"type": "string", "minLength": 10},
        "cutout_style": {"type": "string", "minLength": 20},
        "typography": {"type": "string", "minLength": 20},
        "continuity_rules": {
          "type": "array", "minItems": 4, "maxItems": 12,
          "items": {"type": "string", "minLength": 3}
        }
      }
    },
    "shots": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "kind", "placement", "purpose", "layout", "eyebrow",
          "headline", "subheadline", "visual_story", "key_elements",
          "explainers", "motion_cues", "filename", "alt_text", "caption"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9]{2}$"},
          "kind": {"type": "string", "enum": ["hero", "inline"]},
          "placement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section_heading", "section_index", "after_paragraph_index",
              "after_paragraph_excerpt", "reason"
            ],
            "properties": {
              "section_heading": {"type": "string", "minLength": 1, "maxLength": 180},
              "section_index": {"type": "integer", "minimum": 0, "maximum": 100},
              "after_paragraph_index": {"type": "integer", "minimum": 0, "maximum": 1000},
              "after_paragraph_excerpt": {"type": "string", "minLength": 5, "maxLength": 240},
              "reason": {"type": "string", "minLength": 10, "maxLength": 280}
            }
          },
          "purpose": {
            "type": "string",
            "enum": ["overview", "mechanism", "process", "comparison", "timeline", "evidence", "result"]
          },
          "layout": {
            "type": "string",
            "enum": [
              "hero-explainer", "mechanism-focus", "process-strip",
              "comparison-split", "timeline-route", "result-board"
            ]
          },
          "eyebrow": {"type": "string", "minLength": 1, "maxLength": 40},
          "headline": {"type": "string", "minLength": 4, "maxLength": 90},
          "subheadline": {"type": "string", "minLength": 8, "maxLength": 180},
          "visual_story": {"type": "string", "minLength": 40, "maxLength": 1200},
          "key_elements": {
            "type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true,
            "items": {"type": "string", "minLength": 2, "maxLength": 140}
          },
          "explainers": {
            "type": "array", "minItems": 2, "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "body", "accent", "visual_anchor"],
              "properties": {
                "title": {"type": "string", "minLength": 1, "maxLength": 60},
                "body": {"type": "string", "minLength": 4, "maxLength": 150},
                "accent": {
                  "anyOf": [
                    {"enum": ["ink", "terracotta", "ochre", "sage", "indigo", "brick"]},
                    {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
                  ]
                },
                "visual_anchor": {"type": "string", "minLength": 3, "maxLength": 160}
              }
            }
          },
          "motion_cues": {
            "type": "array", "minItems": 1, "maxItems": 4,
            "items": {"type": "string", "minLength": 3, "maxLength": 220}
          },
          "filename": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+\\.png$"},
          "alt_text": {"type": "string", "minLength": 12, "maxLength": 240},
          "caption": {"type": "string", "maxLength": 300}
        }
      }
    }
  }
}

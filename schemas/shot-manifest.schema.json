{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/editorial-documentary-shot-manifest.schema.json",
  "title": "Editorial Documentary Illustration Shot Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "article", "visual_bible", "shots"],
  "properties": {
    "version": {"type": "integer", "const": 4},
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title", "slug", "language", "annotation_language", "summary", "target_count",
        "article_type", "visual_thesis", "topic_signature", "global_must_avoid"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "language": {
          "type": "string",
          "pattern": "^(?:[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*|und|mul)$",
          "not": {"enum": ["auto", "detect", "automatic"]}
        },
        "annotation_language": {
          "type": "string",
          "pattern": "^(?:[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*|mul)$",
          "not": {"enum": ["auto", "detect", "automatic", "und"]}
        },
        "summary": {"type": "string", "minLength": 20},
        "target_count": {"type": "integer", "minimum": 1, "maximum": 9},
        "article_type": {
          "type": "string",
          "enum": [
            "technical-research", "product-or-company", "historical", "policy-or-economy",
            "social-or-cultural", "process-or-howto", "general"
          ]
        },
        "visual_thesis": {"type": "string", "minLength": 20, "maxLength": 320},
        "topic_signature": {
          "type": "array", "minItems": 3, "maxItems": 10, "uniqueItems": true,
          "items": {"type": "string", "minLength": 2, "maxLength": 100}
        },
        "global_must_avoid": {
          "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 160}
        }
      }
    },
    "visual_bible": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_summary", "background", "palette", "camera", "lighting",
        "character_system", "recurring_motif", "continuity_rules"
      ],
      "properties": {
        "world_summary": {"type": "string", "minLength": 20},
        "background": {"type": "string", "minLength": 20},
        "palette": {
          "type": "array", "minItems": 4, "maxItems": 7,
          "items": {"type": "string", "minLength": 3}
        },
        "camera": {
          "type": "string",
          "enum": ["top-down-map-15deg", "flat-orthographic", "soft-isometric"]
        },
        "lighting": {"type": "string", "minLength": 10},
        "character_system": {"type": "string", "minLength": 20},
        "recurring_motif": {"type": "string", "minLength": 10},
        "continuity_rules": {
          "type": "array", "minItems": 4, "maxItems": 12,
          "items": {"type": "string", "minLength": 3}
        }
      }
    },
    "shots": {
      "type": "array", "minItems": 1, "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "image_role", "visualization_mode", "placement_after", "anchor", "role",
          "core_idea", "composition", "main_subject", "supporting_elements", "motion_cues",
          "density", "people_count", "semantic_contract", "filename", "alt_text", "caption", "annotation"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9]{2}$"},
          "image_role": {"type": "string", "enum": ["hero", "inline"]},
          "visualization_mode": {
            "type": "string",
            "enum": ["literal-technical", "literal-scene", "hybrid-metaphor", "abstract-metaphor"]
          },
          "placement_after": {"type": "string", "minLength": 3},
          "anchor": {"type": "string", "minLength": 5},
          "role": {
            "type": "string",
            "enum": [
              "process-station", "route-network", "timeline-journey", "before-after",
              "scale-up-crowd", "cutaway-mechanism", "ecosystem-tableau", "physical-metaphor",
              "evidence-chain", "origin-map", "technical-mechanism", "architecture-stack",
              "resource-contrast", "claim-comparison"
            ]
          },
          "core_idea": {"type": "string", "minLength": 10, "maxLength": 320},
          "composition": {"type": "string", "minLength": 30, "maxLength": 1600},
          "main_subject": {"type": "string", "minLength": 5, "maxLength": 240},
          "supporting_elements": {
            "type": "array", "maxItems": 8,
            "items": {"type": "string", "minLength": 2, "maxLength": 180}
          },
          "motion_cues": {
            "type": "array", "minItems": 1, "maxItems": 5,
            "items": {"type": "string", "minLength": 3, "maxLength": 240}
          },
          "density": {"type": "string", "enum": ["low", "medium", "high", "resolved-medium"]},
          "people_count": {"type": "integer", "minimum": 0, "maximum": 30},
          "semantic_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_basis", "must_show", "must_not_show", "visual_evidence",
              "specificity_terms", "expected_blind_caption", "hero_artifact"
            ],
            "properties": {
              "source_basis": {
                "type": "array", "minItems": 1, "maxItems": 4,
                "items": {"type": "string", "minLength": 12, "maxLength": 320}
              },
              "must_show": {
                "type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true,
                "items": {"type": "string", "minLength": 3, "maxLength": 180}
              },
              "must_not_show": {
                "type": "array", "maxItems": 8, "uniqueItems": true,
                "items": {"type": "string", "minLength": 3, "maxLength": 180}
              },
              "visual_evidence": {
                "type": "array", "minItems": 2, "maxItems": 6,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["concept", "visible_form", "relationship"],
                  "properties": {
                    "concept": {"type": "string", "minLength": 3, "maxLength": 160},
                    "visible_form": {"type": "string", "minLength": 8, "maxLength": 320},
                    "relationship": {"type": "string", "minLength": 8, "maxLength": 320}
                  }
                }
              },
              "specificity_terms": {
                "type": "array", "minItems": 2, "maxItems": 10, "uniqueItems": true,
                "items": {"type": "string", "minLength": 2, "maxLength": 100}
              },
              "expected_blind_caption": {"type": "string", "minLength": 20, "maxLength": 360},
              "hero_artifact": {"type": "string", "maxLength": 240}
            }
          },
          "filename": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+\\.png$"},
          "alt_text": {"type": "string", "minLength": 12, "maxLength": 240},
          "caption": {"type": "string", "maxLength": 300},
          "annotation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled", "language", "layout_status"],
            "properties": {
              "enabled": {"type": "boolean"},
              "language": {
                "type": "string",
                "pattern": "^(?:[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*)$",
                "not": {"enum": ["auto", "detect", "automatic", "und", "mul"]}
              },
              "layout_status": {"type": "string", "enum": ["draft", "final"]},
              "headline": {"$ref": "#/$defs/headline"},
              "labels": {
                "type": "array", "minItems": 3, "maxItems": 7,
                "items": {"$ref": "#/$defs/label"}
              }
            },
            "allOf": [{
              "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
              "then": {"required": ["headline", "labels"]}
            }]
          },
          "motion_beats": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": {"type": "string", "minLength": 5}
          }
        }
      }
    }
  },
  "$defs": {
    "accent": {
      "anyOf": [
        {"enum": ["ink", "terracotta", "ochre", "sage", "indigo", "brick"]},
        {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
      ]
    },
    "headline": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "x", "y", "accent", "font_size", "angle"],
      "properties": {
        "text": {"type": "string", "minLength": 2, "maxLength": 80},
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "accent": {"$ref": "#/$defs/accent"},
        "font_size": {"type": "integer", "minimum": 28, "maximum": 56},
        "angle": {"type": "number", "minimum": -4, "maximum": 4}
      }
    },
    "label": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "x", "y", "target_x", "target_y", "accent", "font_size", "angle"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 50},
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "target_x": {"type": "number", "minimum": 0, "maximum": 1},
        "target_y": {"type": "number", "minimum": 0, "maximum": 1},
        "accent": {"$ref": "#/$defs/accent"},
        "font_size": {"type": "integer", "minimum": 22, "maximum": 44},
        "angle": {"type": "number", "minimum": -4, "maximum": 4}
      }
    }
  }
}
